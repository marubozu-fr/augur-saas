# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Augur API (server-side only — NEVER prefix with NEXT_PUBLIC_)
AUGUR_API_URL=http://localhost:8000
AUGUR_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode — serves stats from the bundled demo-data/ snapshot and disables
# Supabase/Stripe entirely (see README.md § Demo mode). Requires a rebuild to change.
NEXT_PUBLIC_DEMO_MODE=false
